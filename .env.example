# WEMO Control System Configuration

# Flask API Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
FLASK_ENV=production

# Logging
LOG_LEVEL=INFO

# Device Discovery
DISCOVERY_TIMEOUT=5
MAX_RETRIES=3

# API Security (if exposing over network)
API_KEY=your_api_key_here
ENABLE_AUTH=False
